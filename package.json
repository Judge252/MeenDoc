{
  "name": "meendoc",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "db:verify": "tsx scripts/verify-migrations.ts",
    "db:seed": "tsx scripts/generate-seed.ts",
    "db:types": "tsx scripts/generate-database-types.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "ai:smoke": "node --conditions=react-server --import tsx scripts/smoke-gemini.ts",
    "verify:live": "tsx scripts/verify-live.ts",
    "verify:deployment": "tsx scripts/verify-deployment.ts",
    "verify:http": "node scripts/verify-http.mjs",
    "check:secrets": "node scripts/check-client-secrets.mjs"
  },
  "dependencies": {
    "@google/genai": "2.28.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "0.5.9",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "supabase": "2.120.0",
    "tailwindcss": "^4.1.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "vitest": "5.0.4"
  },
  "type": "module"
}
