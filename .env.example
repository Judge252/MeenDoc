# Technical demo: real persistence, fictional practitioners and clinic bookings.
# Use APP_MODE=offline explicitly for the original in-memory prototype.
APP_MODE=demo
DEMO_SAFE_MODE=true
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# New Supabase secret keys are also supported (server-only).
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LIVE_AI_ENABLED=false
GEMINI_TIMEOUT_MS=15000
AI_REQUEST_LIMIT_PER_HOUR=20
AI_DAILY_USAGE_LIMIT=200
AI_MAX_OUTPUT_TOKENS=700
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_CONTEXT_CHARACTERS=12000
BOOKING_WINDOW_DAYS=14
# At least 32 random characters. Used only for pseudonymous abuse counters.
RATE_LIMIT_SECRET=
CRON_SECRET=
# Optional local Supabase/CI fixture setup only; never configure in public deployment.
MEENDOC_TEST_URL=
